PORT=5000
JWT_SECRET=change_this_to_something_random

# If using Neon, just set this one line (paste your Neon connection string)
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/store_ratings?sslmode=require

# If using local Postgres instead, comment out DATABASE_URL above and use these:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=store_ratings
